CREATE DATABASE analysis_database;
CREATE DATABASE IF NOT EXISTS analysis_database;

USE analysis_database;

CREATE TABLE regioes (
	id_regioes INT PRIMARY KEY AUTO_INCREMENT,
    regioes TEXT
);

CREATE TABLE desemprego (
	id_taxa INT PRIMARY KEY AUTO_INCREMENT,
	ano INT NOT NULL,
	trimestre INT CHECK (trimestre BETWEEN 1 AND 4),
    taxa_desemprego FLOAT NOT NULL
);

SELECT * FROM analysis_database.regioes;


CREATE TABLE renda_media (
	id_renda INT PRIMARY KEY AUTO_INCREMENT,
	ano INT NOT NULL,
	trimestre INT CHECK (trimestre BETWEEN 1 AND 4),
    taxa_renda_media FLOAT NOT NULL,
    uf TEXT
);
